# URL base de la instancia de Scrob (sin barra final)
SCROB_URL=http://scrob.example.local:7330
DATA_PATH=/ruta/a/tu/carpeta/scrob-export/app

# Credenciales del usuario de Scrob
SCROB_USERNAME=tu_usuario
SCROB_PASSWORD=tu_password

# Opcional: Puerto de escucha del host (por defecto 7329) y Zona horaria (por defecto UTC)
HOST_PORT=7329
TZ=UTC
